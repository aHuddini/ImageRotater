<UserControl x:Class="ImageRotater.Controls.SteamGridDbSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">

            <!-- Sources are peers, not a primary and a fallback. Results share
                 the same shape, so the filters, click-to-select and download
                 below work on either. Switching tabs re-runs the search so the
                 results always match the visible tab. -->
            <TabControl x:Name="SourceTabs"
                        Margin="0,0,0,8"
                        SelectionChanged="SourceTabs_SelectionChanged">
                <TabItem x:Name="SteamGridDbTab" Header="SteamGridDB">
                    <TextBlock Text="Curated game artwork, filtered by shape and style."
                               FontSize="11"
                               Foreground="Gray"
                               Margin="6,4"/>
                </TabItem>
                <TabItem x:Name="WebTab" Header="Web search">
                    <TextBlock Text="Any image on the web. Quality and shape vary, so check the size before picking."
                               FontSize="11"
                               Foreground="Gray"
                               Margin="6,4"/>
                </TabItem>
            </TabControl>

        <DockPanel>
            <Button x:Name="SearchButton"
                    Content="Search"
                    DockPanel.Dock="Right"
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Click="SearchButton_Click"/>
            <TextBox x:Name="SearchBox"
                     VerticalContentAlignment="Center"
                     Padding="4"
                     KeyDown="SearchBox_KeyDown"/>
        </DockPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Filters, built from whatever the current results contain -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Shape and size" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding AspectGroups}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <!-- Ticking the group ticks every dimension
                                         under it, so "all square covers" is one
                                         click. -->
                                    <CheckBox Content="{Binding Label}"
                                              IsChecked="{Binding IsChecked}"
                                              FontWeight="SemiBold"
                                              Margin="0,2"/>
                                    <ItemsControl ItemsSource="{Binding Dimensions}"
                                                  Margin="18,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}"
                                                          IsChecked="{Binding IsChecked}"
                                                          Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Style" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding StyleOptions}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}"
                                          IsChecked="{Binding IsChecked}"
                                          Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Format, kept apart from the content warnings below.
                         Those three are "show me something I might not want to
                         see"; this one is "what kind of file is it" - unrelated
                         questions that only looked alike by sitting together.

                         No per-format note here any more. It listed which
                         formats animate WHERE, and that answer depends on the
                         theme rather than on the plugin, so it went stale the
                         moment a theme changed. -->
                    <TextBlock Text="Animation" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ShowAnimatedBox"
                              Content="Look for animated content"
                              Margin="0,2,0,12"/>

                    <TextBlock Text="Also show" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ShowNsfwBox" Content="Adult content" Margin="0,2"/>
                    <CheckBox x:Name="ShowHumorBox" Content="Humour" Margin="0,2"/>
                    <CheckBox x:Name="ShowEpilepsyBox" Content="Flashing images" Margin="0,2"/>

                    <Button Content="Apply filters"
                            Margin="0,12,0,0"
                            Click="ApplyFilters_Click"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Results -->
            <ListBox Grid.Column="1"
                     x:Name="ResultsList"
                     ItemsSource="{Binding Results}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <!-- Selection is the tiles' own toggle state, so the ListBox must
                     not also track a selection - two competing highlights, and a
                     click would mean both "toggle this" and "select this". -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- The whole tile is the hit target, not just a checkbox.
                             Bound to the model rather than ListBox.SelectedItems so a
                             tick survives re-filtering: applying a filter rebuilds the
                             list and would otherwise drop it silently.
                             A ToggleButton rather than a CheckBox with content, because
                             its template can be replaced outright - a CheckBox would
                             still draw its own box beside the image. -->
                        <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Cursor="Hand"
                                      ToolTip="Click to select. Pick as many as you like, then Download selected."
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Frame"
                                            Width="240"
                                            Margin="6"
                                            Padding="6"
                                            CornerRadius="3"
                                            Background="Transparent"
                                            BorderThickness="2"
                                            BorderBrush="Transparent">
                                        <StackPanel>
                                            <Grid>
                                                <!-- GIFs preview LIVE: the full file plays in the
                                                     tile via XamlAnimatedGif. Everything else shows
                                                     the static thumbnail.

                                                     The animation is attached from code-behind, not
                                                     declared here. A gif: xmlns would send BAML down
                                                     Assembly.Load, which never probes the extension
                                                     folder, and InitializeComponent would throw
                                                     before this view built a single element - the
                                                     dialog would not open at all. Code-behind
                                                     resolves in the LoadFrom context instead, which
                                                     is how the cover control has always done it. -->
                                                <Image Height="112"
                                                       Stretch="UniformToFill"
                                                       Source="{Binding ThumbnailUrl}"
                                                       Loaded="ResultImage_Loaded"/>

                                                <!-- Badge so animated results are identifiable at a
                                                     glance even before the frames arrive. -->
                                                <Border Visibility="{Binding IsGif, Converter={StaticResource BoolToVisibility}}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="4"
                                                        Padding="4,1"
                                                        CornerRadius="3"
                                                        Background="#B0000000">
                                                    <TextBlock Text="GIF"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>

                                                <!-- Only shown once selected, so an
                                                     unpicked grid stays uncluttered. -->
                                                <Border x:Name="Tick"
                                                        Visibility="Collapsed"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="4"
                                                        Width="22" Height="22"
                                                        CornerRadius="11"
                                                        Background="{DynamicResource GlyphBrush}">
                                                    <TextBlock Text="&#x2713;"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextBrushDarker}"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding Dimensions}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Style}"
                                                       HorizontalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="Gray"/>
                                        </StackPanel>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Frame" Property="BorderBrush"
                                                    Value="{DynamicResource GlyphBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Frame" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Status + actions -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="DownloadButton"
                    Content="Download selected"
                    DockPanel.Dock="Right"
                    MinWidth="140"
                    Margin="8,0,0,0"
                    Click="DownloadButton_Click"/>
            <Button Content="Close"
                    DockPanel.Dock="Right"
                    MinWidth="90"
                    Click="CloseButton_Click"/>
            <!-- Foreground must be set explicitly. Without it the TextBlock
                 inherits WPF's default black, which is unreadable on a dark
                 Playnite theme - the status was effectively invisible.
                 TextBrush follows whatever theme is active; the literal is only
                 a fallback for a theme that omits it, since DynamicResource has
                 no FallbackValue of its own. -->
            <Border Padding="8,5"
                    CornerRadius="3"
                    Background="#22808080">
                <StackPanel Orientation="Horizontal">

                    <!-- Spins only while a search is running, so "working" and
                         "finished with nothing" stop looking identical. -->
                    <TextBlock x:Name="BusyGlyph"
                               Text="&#x25CF;"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="{DynamicResource GlyphBrush}"
                               Visibility="Collapsed">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="Pulse">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0.15" Duration="0:0:0.6"
                                                                     AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Pulse"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding Status}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
