<UserControl x:Class="ImageRotater.Controls.SteamGridDbSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">

            <!-- Sources are peers, not a primary and a fallback. Results share
                 the same shape, so the filters, click-to-select and download
                 below work on either. Switching tabs re-runs the search so the
                 results always match the visible tab. -->
            <TabControl x:Name="SourceTabs"
                        Margin="0,0,0,8"
                        SelectionChanged="SourceTabs_SelectionChanged">
                <TabItem x:Name="SteamGridDbTab" Header="SteamGridDB">
                    <TextBlock Text="Curated game artwork, filtered by shape and style."
                               FontSize="11"
                               Foreground="Gray"
                               Margin="6,4"/>
                </TabItem>
                <TabItem x:Name="WebTab" Header="Web search">
                    <TextBlock Text="Any image on the web. Quality and shape vary, so check the size before picking."
                               FontSize="11"
                               Foreground="Gray"
                               Margin="6,4"/>
                </TabItem>
            </TabControl>

        <DockPanel>
            <Button x:Name="SearchButton"
                    Content="Search"
                    DockPanel.Dock="Right"
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Click="SearchButton_Click"/>

            <!-- Fullscreen only. The filter column starts collapsed there, so
                 this is how a controller user gets it back without a mouse. -->
            <ToggleButton x:Name="FilterToggleRow"
                          Content="Filters"
                          DockPanel.Dock="Right"
                          MinWidth="90"
                          Margin="8,0,0,0"
                          Visibility="Collapsed"
                          Checked="FilterToggle_Changed"
                          Unchecked="FilterToggle_Changed"/>

            <TextBox x:Name="SearchBox"
                     VerticalContentAlignment="Center"
                     Padding="4"
                     KeyDown="SearchBox_KeyDown"/>
        </DockPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Collapsed to zero in Fullscreen, where the filter column
                     would eat a third of a TV screen for controls a controller
                     user rarely touches. The Filters button restores it. -->
                <ColumnDefinition x:Name="FiltersColumn" Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Filters, built from whatever the current results contain -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Shape and size" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding AspectGroups}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <!-- Ticking the group ticks every dimension
                                         under it, so "all square covers" is one
                                         click. -->
                                    <CheckBox Content="{Binding Label}"
                                              IsChecked="{Binding IsChecked}"
                                              FontWeight="SemiBold"
                                              Margin="0,2"/>
                                    <ItemsControl ItemsSource="{Binding Dimensions}"
                                                  Margin="18,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}"
                                                          IsChecked="{Binding IsChecked}"
                                                          Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Style" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding StyleOptions}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}"
                                          IsChecked="{Binding IsChecked}"
                                          Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Format, kept apart from the content warnings below.
                         Those three are "show me something I might not want to
                         see"; this one is "what kind of file is it" - unrelated
                         questions that only looked alike by sitting together.

                         No per-format note here any more. It listed which
                         formats animate WHERE, and that answer depends on the
                         theme rather than on the plugin, so it went stale the
                         moment a theme changed. -->
                    <TextBlock Text="Animation" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ShowAnimatedBox"
                              Content="Look for animated content"
                              Margin="0,2"/>

                    <!-- On by default. Smaller on disk, and MP4 plays through
                         MediaElement - hardware-assisted - where a GIF decodes
                         frame by frame on the UI thread. Disabled outright when
                         ffmpeg is missing, with the label saying so, rather
                         than silently doing nothing. -->
                    <CheckBox x:Name="ConvertGifsBox"
                              Content="Convert GIFs to MP4 on download"
                              IsChecked="True"
                              Margin="0,2,0,2"/>
                    <TextBlock x:Name="ConvertGifsNote"
                               Text="Smaller files, and smoother playback than an animated GIF."
                               FontSize="10"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Also show" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ShowNsfwBox" Content="Adult content" Margin="0,2"/>
                    <CheckBox x:Name="ShowHumorBox" Content="Humour" Margin="0,2"/>
                    <CheckBox x:Name="ShowEpilepsyBox" Content="Flashing images" Margin="0,2"/>

                    <Button Content="Apply filters"
                            Margin="0,12,0,0"
                            Click="ApplyFilters_Click"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Results -->
            <ListBox Grid.Column="1"
                     x:Name="ResultsList"
                     ItemsSource="{Binding Results}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <!-- Selection is the tiles' own toggle state, so the ListBox must
                     not also track a selection - two competing highlights, and a
                     click would mean both "toggle this" and "select this".
                     The container therefore stays unfocusable and untemplated;
                     the ToggleButton inside each tile is what takes focus, which
                     is what makes D-pad navigation land on something that can
                     actually be activated. -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- The whole tile is the hit target, not just a checkbox.
                             Bound to the model rather than ListBox.SelectedItems so a
                             tick survives re-filtering: applying a filter rebuilds the
                             list and would otherwise drop it silently.
                             A ToggleButton rather than a CheckBox with content, because
                             its template can be replaced outright - a CheckBox would
                             still draw its own box beside the image. -->
                        <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Cursor="Hand"
                                      ToolTip="Click to select. Pick as many as you like, then Download selected."
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <!-- Tile width comes from the view, not a
                                         literal: Fullscreen is read from a sofa
                                         and 240px of artwork that is comfortable
                                         on a monitor is a postage stamp on a TV.
                                         Set once in code from the application
                                         mode. -->
                                    <Border x:Name="Frame"
                                            Width="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Margin="6"
                                            Padding="6"
                                            CornerRadius="3"
                                            Background="Transparent"
                                            BorderThickness="2"
                                            BorderBrush="Transparent">
                                        <StackPanel>
                                            <Grid>
                                                <!-- Every tile shows the static THUMBNAIL, animated
                                                     or not.

                                                     GIFs used to play here, which meant handing
                                                     XamlAnimatedGif the full-size remote URL for
                                                     every visible result - a dozen whole GIFs
                                                     downloading and decoding at once, on the UI
                                                     thread, in a 32-bit process. That froze and
                                                     crashed Playnite, worst on a web search where
                                                     results have no size ceiling.

                                                     Animation lives in the preview window now:
                                                     one file at a time, and only when asked for. -->
                                                <Image Height="{Binding ThumbnailHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       Stretch="UniformToFill"
                                                       Source="{Binding ThumbnailUrl}"
                                                       Loaded="ResultImage_Loaded"
                                                       MouseEnter="ResultImage_MouseEnter"
                                                       MouseLeave="ResultImage_MouseLeave"/>

                                                <!-- Badge so animated results are identifiable at a
                                                     glance even before the frames arrive. -->
                                                <Border Visibility="{Binding IsGif, Converter={StaticResource BoolToVisibility}}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="4"
                                                        Padding="4,1"
                                                        CornerRadius="3"
                                                        Background="#B0000000">
                                                    <TextBlock Text="GIF"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>

                                                <!-- Only shown once selected, so an
                                                     unpicked grid stays uncluttered. -->
                                                <Border x:Name="Tick"
                                                        Visibility="Collapsed"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="4"
                                                        Width="22" Height="22"
                                                        CornerRadius="11"
                                                        Background="{DynamicResource GlyphBrush}">
                                                    <TextBlock Text="&#x2713;"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextBrushDarker}"/>
                                                </Border>

                                                <!-- Opens the full image, at size, in its own
                                                     window - and it is where an animated result
                                                     actually plays.

                                                     A thumbnail says almost nothing about whether a
                                                     1920x620 banner is the right shape for a
                                                     background, or how much a GIF actually moves.
                                                     Bottom-right so it does not sit under the GIF
                                                     badge or the selection tick. -->
                                                <Button Content="&#x1F441;"
                                                        ToolTip="Preview at full size"
                                                        Click="Preview_Click"
                                                        Tag="{Binding}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="4"
                                                        Width="26" Height="26"
                                                        Padding="0"
                                                        FontSize="13"
                                                        Focusable="False"/>
                                            </Grid>

                                            <TextBlock Text="{Binding Dimensions}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Style}"
                                                       HorizontalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="Gray"/>
                                        </StackPanel>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Frame" Property="BorderBrush"
                                                    Value="{DynamicResource GlyphBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Frame" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>

                                        <!-- Where the D-pad is.
                                             Without this a controller user has no
                                             idea which tile Enter would activate -
                                             the tick marks what is SELECTED, which
                                             is a different question. Brighter than
                                             the hover wash so the two read apart
                                             when a mouse and a pad are both in
                                             use. -->
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Frame" Property="Background" Value="#33FFFFFF"/>
                                            <Setter TargetName="Frame" Property="BorderBrush"
                                                    Value="{DynamicResource TextBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Status + actions -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="DownloadButton"
                    Content="Download selected"
                    DockPanel.Dock="Right"
                    MinWidth="140"
                    Margin="8,0,0,0"
                    Click="DownloadButton_Click"/>

            <!-- Paging, shown only when there is more than one page.
                 A web search can return a hundred hits, and every visible tile
                 fetches and decodes a remote thumbnail - so a page is a ceiling
                 on how much work one search starts, not a layout preference. -->
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolToVisibility}}">
                <Button Content="&#x25C0;"
                        Width="30"
                        Padding="0"
                        IsEnabled="{Binding CanGoBack}"
                        Click="PreviousPage_Click"/>
                <TextBlock Text="{Binding PageLabel}"
                           VerticalAlignment="Center"
                           Margin="8,0"
                           FontSize="11"/>
                <Button Content="&#x25B6;"
                        Width="30"
                        Padding="0"
                        IsEnabled="{Binding CanGoForward}"
                        Click="NextPage_Click"/>
            </StackPanel>
            <Button Content="Close"
                    DockPanel.Dock="Right"
                    MinWidth="90"
                    Click="CloseButton_Click"/>
            <!-- Foreground must be set explicitly. Without it the TextBlock
                 inherits WPF's default black, which is unreadable on a dark
                 Playnite theme - the status was effectively invisible.
                 TextBrush follows whatever theme is active; the literal is only
                 a fallback for a theme that omits it, since DynamicResource has
                 no FallbackValue of its own. -->
            <Border Padding="8,5"
                    CornerRadius="3"
                    Background="#22808080">
                <StackPanel Orientation="Horizontal">

                    <!-- Spins only while a search is running, so "working" and
                         "finished with nothing" stop looking identical. -->
                    <TextBlock x:Name="BusyGlyph"
                               Text="&#x25CF;"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="{DynamicResource GlyphBrush}"
                               Visibility="Collapsed">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="Pulse">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0.15" Duration="0:0:0.6"
                                                                     AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Pulse"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding Status}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
