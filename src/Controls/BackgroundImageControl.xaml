<c:PluginUserControl x:Class="ImageRotater.Controls.BackgroundImageControl"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:c="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK">
    <Grid x:Name="RootGrid" ClipToBounds="True">

        <Image x:Name="DisplayImage"
               Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- Video artwork. A separate element rather than a mode of the Image:
             MediaElement is its own renderer, and only one of the two is ever
             visible at a time (the one-channel rule the GIF path follows).

             LoadedBehavior=Manual is required to drive Play/Stop from
             code-behind; the default Play behaviour starts on load and ignores
             the calls. Muted always - artwork that made noise while browsing a
             library would be a bug, not a feature. -->
        <MediaElement x:Name="DisplayVideo"
                      Visibility="Collapsed"
                      Stretch="UniformToFill"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      IsMuted="True"
                      ScrubbingEnabled="False"
                      MediaEnded="DisplayVideo_MediaEnded"
                      MediaFailed="DisplayVideo_MediaFailed"/>

        <!-- Shown only when a path exists but the file is missing or corrupt.
             Never shown for "this game has no image" - that renders nothing so
             the theme's own background shows through. Vector-drawn so it stays
             crisp from 480px to 3840px without shipping bitmap assets. -->
        <!-- Tag carries the theme brush; the shapes bind to it with a grey
             fallback. DynamicResource has no FallbackValue of its own and
             resolves to null in a theme that omits TextBrush, which would
             render the placeholder invisible - the one visual whose entire job
             is signalling a problem. A local fallback resource would not work:
             it shadows the theme's brush instead of deferring to it. -->
        <Viewbox x:Name="MissingImagePlaceholder"
                 Visibility="Collapsed"
                 Tag="{DynamicResource TextBrush}"
                 Width="96" Height="96"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Opacity="0.28">
            <Canvas Width="24" Height="24">
                <Path Data="M3,3 H21 V21 H3 Z"
                      Stroke="{Binding Tag, ElementName=MissingImagePlaceholder, TargetNullValue=#FFCCCCCC, FallbackValue=#FFCCCCCC}"
                      StrokeThickness="1.2"
                      Fill="Transparent"/>
                <Path Data="M9.2,9.1 C9.2,7.7 10.4,6.8 12,6.8 C13.6,6.8 14.8,7.7 14.8,9.1 C14.8,10.6 13.4,10.9 12.6,11.8 C12.2,12.3 12.1,12.8 12.1,13.6"
                      Stroke="{Binding Tag, ElementName=MissingImagePlaceholder, TargetNullValue=#FFCCCCCC, FallbackValue=#FFCCCCCC}"
                      StrokeThickness="1.4"
                      Fill="Transparent"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>
                <Ellipse Canvas.Left="11.35" Canvas.Top="15.2"
                         Width="1.4" Height="1.4"
                         Fill="{Binding Tag, ElementName=MissingImagePlaceholder, TargetNullValue=#FFCCCCCC, FallbackValue=#FFCCCCCC}"/>
            </Canvas>
        </Viewbox>

    </Grid>
</c:PluginUserControl>
